# Bot User OAuth Token (OAuth & Permissions page) - starts with xoxb-
SLACK_BOT_TOKEN=xoxb-your-token

# Signing Secret (Basic Information page) - required for HTTP mode
SLACK_SIGNING_SECRET=your-signing-secret

# Optional: App-Level Token with connections:write (starts with xapp-).
# If set, the bot runs in Socket Mode and needs no public URL.
SLACK_APP_TOKEN=

PORT=3000
